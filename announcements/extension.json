{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "announcements",
    "name": "公告",
    "version": "1.0.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": "^2.0.0-beta.4",
        "php": "^8.3"
    },
    "description": "全站公告横幅，支持类型配色、生效时段、按区域定向展示以及按用户关闭。",
    "author": "Anthony",
    "provider": "Announcements\\AnnouncementsProvider",
    "autoload": {
        "Announcements\\": "src"
    },
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "ann",
        "screens": [
            {
                "id": "announcements",
                "area": "admin",
                "path": "announcements",
                "nav": {
                    "label": "公告",
                    "icon": "megaphone"
                }
            }
        ]
    }
}
