{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "beian",
    "name": "备案信息",
    "version": "1.0.0",
    "description": "在每个页面的底部显示 ICP 备案号、公安备案号与 ICP 许可证，并链接到对应的备案查询系统。",
    "author": "pterodactyl-china",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": "^2.0.0-beta.4",
        "php": "^8.3"
    },
    "provider": "Beian\\BeianProvider",
    "autoload": {
        "Beian\\": "src"
    },
    "routes": {
        "root": ["beian"]
    },
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "bcn"
    }
}
