{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "custom-buttons",
    "name": "自定义按钮",
    "version": "1.0.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": "^2.0.0-beta.4",
        "php": "^8.3"
    },
    "description": "由管理员定义的按钮与侧边栏链接，显示在服务器页面上，URL 支持服务器占位符，并可按 Egg 过滤，可自定义图标与配色。",
    "author": "Anthony",
    "provider": "CustomButtons\\CustomButtonsProvider",
    "autoload": {
        "CustomButtons\\": "src"
    },
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "cb",
        "screens": [
            {
                "id": "custom-buttons",
                "area": "admin",
                "path": "custom-buttons",
                "nav": {
                    "label": "自定义按钮",
                    "icon": "puzzle"
                }
            }
        ]
    }
}
