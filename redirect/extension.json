{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "redirect",
    "name": "短链接跳转",
    "version": "1.0.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": "^2.0.0-beta.4",
        "php": "^8.3"
    },
    "description": "由面板提供服务的短链接跳转，可在管理区域中维护。",
    "author": "Anthony",
    "provider": "Redirect\\RedirectProvider",
    "autoload": {
        "Redirect\\": "src"
    },
    "routes": {
        "root": ["go"]
    },
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "rdr",
        "screens": [
            {
                "id": "redirects",
                "area": "admin",
                "path": "redirects",
                "nav": {
                    "label": "短链接跳转",
                    "icon": "puzzle"
                }
            }
        ]
    }
}
